#!/sbin/sh
#
# QuantumROM Recovery Flashable Installer for Samsung Galaxy Tab S6 Lite (SM-P613 / gta4xlve)
#

OUTFD="/proc/self/fd/$2"
ZIPFILE="$3"

ui_print() {
    echo "ui_print $1" > "$OUTFD"
    echo "ui_print" > "$OUTFD"
}

set_progress() {
    echo "set_progress $1" > "$OUTFD"
}

ui_print "============================================"
ui_print "          QuantumROM OS Installer           "
ui_print "    One UI 8.5 Port for Galaxy Tab S6 Lite  "
ui_print "============================================"
ui_print " "

TMP_DIR="/tmp/quantum_installer"
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"
mkdir -p "$TMP_DIR/tools"

set_progress 0.05

# Verify device
DEVICE=$(getprop ro.product.device)
[ -z "$DEVICE" ] && DEVICE=$(getprop ro.build.product)
MODEL=$(getprop ro.product.model)

ui_print "[*] Target Device: $MODEL ($DEVICE)"

case "$DEVICE" in
    *gta4xlve*|*gta4xl*|*p613*|*P613*|*p619*|*P619*)
        ui_print "[+] Supported device detected!"
        ;;
    *)
        ui_print "[!] Warning: Unknown device code ($DEVICE), proceeding..."
        ;;
esac

ui_print " "
ui_print "[*] Extracting installer tools..."
unzip -o "$ZIPFILE" "tools/*" "images.info" -d "$TMP_DIR" >/dev/null 2>&1
chmod -R 755 "$TMP_DIR/tools" 2>/dev/null || true

LPTOOLS="$TMP_DIR/tools/lptools_static"
[ ! -f "$LPTOOLS" ] && LPTOOLS="$TMP_DIR/tools/lptools"
[ ! -f "$LPTOOLS" ] && LPTOOLS="/sbin/lptools"
[ ! -f "$LPTOOLS" ] && LPTOOLS="/sbin/lpflash"

# Unmount existing partitions to prevent busy errors
ui_print "[*] Unmounting existing partitions..."
umount /system /system_root /vendor /product /odm /system_ext 2>/dev/null || true

# Dynamic partition helper
SUPER_DEV="/dev/block/by-name/super"
[ ! -e "$SUPER_DEV" ] && SUPER_DEV="/dev/block/bootdevice/by-name/super"
[ ! -e "$SUPER_DEV" ] && SUPER_DEV=$(find /dev/block -name "super" 2>/dev/null | head -n 1)

if [ -e "$SUPER_DEV" ]; then
    ui_print "[+] Dynamic super partition: $SUPER_DEV"
fi

get_part_size() {
    local PART="$1"
    local SIZE=""

    # 1. Check images.info file
    if [ -f "$TMP_DIR/images.info" ]; then
        SIZE=$(grep "^${PART}:" "$TMP_DIR/images.info" | cut -d: -f2 | tr -d ' \r\n')
    fi

    # 2. Check embedded known sizes
    if [ -z "$SIZE" ] || [ "$SIZE" -eq 0 ] 2>/dev/null; then
        case "$PART" in
            system)  SIZE="3074949120" ;;
            vendor)  SIZE="628994048" ;;
            product) SIZE="957112320" ;;
            odm)     SIZE="67108864" ;;
        esac
    fi

    # 3. Fallback to zip header inspection
    if [ -z "$SIZE" ] || [ "$SIZE" -eq 0 ] 2>/dev/null; then
        SIZE=$(unzip -l "$ZIPFILE" "images/${PART}.img" 2>/dev/null | grep "images/${PART}.img" | awk '{print $1}')
    fi

    echo "${SIZE:-0}"
}

flash_partition() {
    local PART="$1"
    local BLOCK_DEV=""

    local IMG_SIZE=$(get_part_size "$PART")
    local SIZE_MB=$(( IMG_SIZE / 1024 / 1024 ))
    ui_print "[*] Flashing $PART (${SIZE_MB} MB)..."

    # If lptools is available and super partition exists, resize & map logical partition
    if [ -x "$LPTOOLS" ] && [ -e "$SUPER_DEV" ] && [ "$IMG_SIZE" -gt 0 ]; then
        ui_print "    Resizing $PART to ${SIZE_MB} MB in dynamic super..."
        "$LPTOOLS" unmap "$PART" 2>/dev/null || true
        "$LPTOOLS" create "$PART" "$IMG_SIZE" 2>/dev/null || true
        "$LPTOOLS" resize "$PART" "$IMG_SIZE" 2>/dev/null || true
        "$LPTOOLS" map "$PART" 2>/dev/null || true
    fi

    # Find block device
    if [ -e "/dev/block/mapper/$PART" ]; then
        BLOCK_DEV="/dev/block/mapper/$PART"
    elif [ -e "/dev/block/by-name/$PART" ]; then
        BLOCK_DEV="/dev/block/by-name/$PART"
    elif [ -e "/dev/block/bootdevice/by-name/$PART" ]; then
        BLOCK_DEV="/dev/block/bootdevice/by-name/$PART"
    fi

    if [ -n "$BLOCK_DEV" ] && [ -e "$BLOCK_DEV" ]; then
        ui_print "    Streaming directly to $BLOCK_DEV..."
        # Direct stream pipe: avoids storing 3GB image in /tmp RAM
        unzip -p "$ZIPFILE" "images/${PART}.img" | dd of="$BLOCK_DEV" bs=4M 2>/dev/null || unzip -p "$ZIPFILE" "images/${PART}.img" | dd of="$BLOCK_DEV" bs=1M
        ui_print "[+] Successfully flashed $PART!"
    else
        ui_print "[!] Error: Target block device for $PART not found!"
    fi
}

set_progress 0.15
flash_partition "system"

set_progress 0.40
flash_partition "vendor"

set_progress 0.60
flash_partition "product"

set_progress 0.75
if unzip -l "$ZIPFILE" "images/odm.img" >/dev/null 2>&1; then
    flash_partition "odm"
fi

if unzip -l "$ZIPFILE" "images/system_ext.img" >/dev/null 2>&1; then
    flash_partition "system_ext"
fi

set_progress 0.85

# Flash Kernel & DTBO
ui_print " "
ui_print "============================================"
ui_print "       Installing Kernel & Boot Image       "
ui_print "============================================"

# Check if direct boot.img / dtbo.img exist
if unzip -l "$ZIPFILE" "images/boot.img" >/dev/null 2>&1; then
    BOOT_DEV="/dev/block/by-name/boot"
    [ ! -e "$BOOT_DEV" ] && BOOT_DEV="/dev/block/bootdevice/by-name/boot"
    if [ -e "$BOOT_DEV" ]; then
        ui_print "[*] Streaming boot.img to $BOOT_DEV..."
        unzip -p "$ZIPFILE" "images/boot.img" | dd of="$BOOT_DEV" bs=4M
        ui_print "[+] boot.img flashed successfully!"
    fi
fi

if unzip -l "$ZIPFILE" "images/dtbo.img" >/dev/null 2>&1; then
    DTBO_DEV="/dev/block/by-name/dtbo"
    [ ! -e "$DTBO_DEV" ] && DTBO_DEV="/dev/block/bootdevice/by-name/dtbo"
    if [ -e "$DTBO_DEV" ]; then
        ui_print "[*] Streaming dtbo.img to $DTBO_DEV..."
        unzip -p "$ZIPFILE" "images/dtbo.img" | dd of="$DTBO_DEV" bs=4M
        ui_print "[+] dtbo.img flashed successfully!"
    fi
fi

# Fallback: execute bundled AnyKernel package if present
if unzip -l "$ZIPFILE" "kernel/kernel.zip" >/dev/null 2>&1; then
    ui_print "[*] Found bundled AnyKernel package. Executing installer..."
    mkdir -p "$TMP_DIR/kernel/ak3"
    unzip -p "$ZIPFILE" "kernel/kernel.zip" > "$TMP_DIR/kernel/kernel.zip"
    unzip -o "$TMP_DIR/kernel/kernel.zip" -d "$TMP_DIR/kernel/ak3" >/dev/null 2>&1
    chmod -R 755 "$TMP_DIR/kernel/ak3"

    if [ -f "$TMP_DIR/kernel/ak3/anykernel.sh" ]; then
        cd "$TMP_DIR/kernel/ak3"
        sh anykernel.sh "$TMP_DIR/kernel/kernel.zip" 2>&1 | while IFS= read -r line; do
            ui_print "    $line"
        done
        ui_print "[+] Kernel patched and flashed!"
    fi
fi

# Cleanup
ui_print " "
ui_print "[*] Cleaning up..."
rm -rf "$TMP_DIR"

set_progress 1.0

ui_print " "
ui_print "============================================"
ui_print "        QuantumROM Flashed Successfully!    "
ui_print "          Please reboot your tablet!        "
ui_print "============================================"
ui_print " "

exit 0
